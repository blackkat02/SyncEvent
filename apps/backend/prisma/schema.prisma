generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Visibility {
  PUBLIC
  PRIVATE
}

enum ParticipantStatus {
  CONFIRMED
  WAITLISTED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  password     String
  displayName  String?
  avatarUrl    String?
  refreshToken String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdEvents  Event[]            @relation("CreatedEvents")
  participations EventParticipant[]
}

/// Transactional outbox: a domain-event row is written in the SAME
/// transaction as the state change that produced it, then a relay publishes
/// it to Kafka and stamps `sentAt`. Guarantees at-least-once delivery even
/// if the process dies between commit and publish. No FK to Event on
/// purpose — the row (e.g. event.deleted) must outlive the event.
model OutboxEvent {
  id        String    @id @default(cuid())
  topic     String
  key       String // Kafka partition key — always the eventId (per-event ordering)
  payload   Json
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([sentAt, createdAt])
}

model Event {
  id           String             @id @default(cuid())
  title        String
  description  String?
  date         DateTime
  location     String
  capacity     Int?
  seatsTaken   Int                @default(0)
  visibility   Visibility         @default(PUBLIC)
  authorId     String
  author       User               @relation("CreatedEvents", fields: [authorId], references: [id])
  participants EventParticipant[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  @@index([authorId])
  @@index([visibility])
}

/// Explicit join model for event participation (replaces the implicit
/// User<->Event M:N table). A composite PK is a real DB constraint the app
/// can rely on for atomic join dedup (see EventsService.joinEvent), unlike
/// re-checking a `participants: none` subquery inside a conditional UPDATE.
/// `status` is the storage Phase 3 (waitlist) needs for WAITLISTED rows,
/// added now so that feature won't require another structural migration.
model EventParticipant {
  eventId  String
  userId   String
  status   ParticipantStatus @default(CONFIRMED)
  joinedAt DateTime          @default(now())
  event    Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId])
}