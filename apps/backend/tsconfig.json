{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "module": "NodeNext",
    "target": "ES2023",
    "types": ["node"],
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "paths": {
      "@syncevent/shared": ["../../packages/shared/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*", "prisma/**/*", "env.ts"],
  "exclude": ["node_modules", "dist"],
  "references": [{ "path": "../../packages/shared" }]
}