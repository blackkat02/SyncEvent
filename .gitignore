dist/
**/dist/
dist-ssr/
/out
/.next/
/packages/db/generated
*.local

# --- Logs ---
logs
*.log
*-debug.log*
*-error.log*

# --- Python (apps/chess-service) ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
