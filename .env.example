# ==============================
# Application
# ==============================
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173

# ==============================
# PostgreSQL
# ==============================
POSTGRES_USER=<postgres_user>
POSTGRES_PASSWORD=<postgres_password>
POSTGRES_DB=<postgres_db_name>
POSTGRES_PORT=5432

# ==============================
# Authentication (JWT)
# ==============================
JWT_SECRET=<generate_a_long_random_string>
JWT_REFRESH_SECRET=<generate_a_different_long_random_string>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ==============================
# Backend / Frontend ports
# ==============================
BACKEND_PORT=3000
FRONTEND_PORT=5173
FRONTEND_NEXT_PORT=3001
VITE_API_URL=http://localhost:3000/api

# ==============================
# Tools (pgAdmin)
# ==============================
PGADMIN_DEFAULT_EMAIL=<admin_email>
PGADMIN_DEFAULT_PASSWORD=<admin_password>
PGADMIN_LISTEN_PORT=5050
# ==============================
# Redis
# ==============================
REDIS_HOST=redis
REDIS_PORT=6379

# ==============================
# Kafka
# ==============================
# Compose services reach the broker at kafka:9092 (hardcoded per-service in
# docker-compose.yml). A Node process on the host uses localhost:29092.
KAFKA_BROKER=localhost:29092
KAFKA_HOST_PORT=29092
