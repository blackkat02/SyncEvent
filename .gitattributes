# Shell scripts and container entrypoints must stay LF even on Windows —
# Alpine's /bin/sh fails on CRLF (exit 127, "line N: : not found").
*.sh            text eol=lf
entrypoint.sh   text eol=lf
*.mjs           text eol=lf
*.cjs           text eol=lf
Dockerfile      text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf

# Windows-only scripts stay CRLF.
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf
