shamefully-hoist=true
node-linker=hoisted
# Don't let pnpm auto-switch to the "packageManager" version at runtime — CI and
# Docker install a pinned pnpm explicitly, and the auto-switch tries to verify a
# @pnpm/exe download that isn't in the lockfile (ERR_PNPM_PNPM_ENGINE_IDENTITY_UNVERIFIABLE).
manage-package-manager-versions=false
